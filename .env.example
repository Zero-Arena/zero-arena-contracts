# Foundry RPC + explorer config
GALILEO_RPC_URL=https://evmrpc-testnet.0g.ai
GALILEO_EXPLORER_URL=https://chainscan-galileo.0g.ai/api
GALILEO_EXPLORER_KEY=

# Deployer wallet — must hold Galileo gas (faucet: https://faucet.0g.ai)
# DEPLOYER_ADDRESS must equal `cast wallet address $DEPLOYER_PRIVATE_KEY`.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# Oracle service signer. The address is written into the on-chain
# ReencryptionOracle at deploy time. The matching private key lives in
# zero-arena-bacend/.env (see .env.oracle.example) on the host running
# `bacend oracle serve` — never in this repo, never in the SDK.
ORACLE_SIGNER_ADDRESS=
