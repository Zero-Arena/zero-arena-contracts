{
  "name": "@zero-arena/contracts",
  "version": "0.4.0",
  "description": "ABIs and deployed addresses for the Zero Arena on-chain contracts.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./abi/*": "./dist/abi/*",
    "./addresses": "./dist/addresses.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:abi": "node scripts/build-abi.mjs",
    "sync:addresses": "node scripts/sync-addresses.mjs",
    "prepublishOnly": "npm run build:abi"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zero-Arena/zero-arena-contracts.git"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
